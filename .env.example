# Copy to .env and fill in real values. Never commit .env.
# Every key the app reads is listed here. Keys marked (required) have no default.

# --- Runtime ---
# dev | test | prod. Defaults to prod (docs hidden, strict checks). Set dev locally.
ENV=dev

# --- Database ---
# (required) Async SQLAlchemy URL. Use a local database for development.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
# Seconds GET /health/ready waits for the database (0.5-30). Neon's free tier suspends idle
# compute, and waking it has taken over 5 s in production.
HEALTH_READY_TIMEOUT_SECONDS=10

# Run "alembic upgrade head" when the container starts (scripts/run.sh). Leave false
# until the database has been stamped; see docs/DB_MIGRATION_RUNBOOK.md.
RUN_MIGRATIONS=false

# --- CORS ---
# Browser origins allowed to call the API: JSON list or comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# --- Client IP and rate limiting ---
# Proxies allowed to tell us the visitor's IP (comma-separated IPs/CIDRs). Empty = trust
# nobody: limits apply to the TCP peer, which is the proxy itself if you are behind one.
#   nginx/Caddy on the same host:  TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12  (Docker bridge)
#   Cloudflare straight to the app: Cloudflare's ranges from https://www.cloudflare.com/ips/
TRUSTED_PROXY_IPS=
# x-forwarded-for (nginx/Caddy) | cf-connecting-ip (Cloudflare, or Cloudflare -> nginx)
CLIENT_IP_HEADER=x-forwarded-for
# memory:// is per worker (with 2 workers, limits are effectively doubled).
# Use redis://host:6379 to share limits across workers and hosts.
RATE_LIMIT_STORAGE_URI=memory://
# Gunicorn/Uvicorn's own proxy-header trust (scripts/run.sh). Keep it consistent with
# TRUSTED_PROXY_IPS; the default trusts only localhost.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Email (contact form) ---
# (required) SMTP server used to deliver contact messages. STARTTLS is used.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# (required) SMTP login, also used as the From address.
SMTP_USER=sender@example.com
# (required)
SMTP_PASSWORD=change-me
# (required) Inbox that receives contact form messages.
SUPER_ADMIN_EMAIL=you@example.com

# --- Contact form ---
# Optional. Public URL of a square avatar shown in contact emails (empty = no image).
EMAIL_AVATAR_URL=
# Email visitors a short "message received" note. Only works when TURNSTILE_SECRET is set.
CONTACT_CONFIRMATION_ENABLED=false

# --- Links shown in emails ---
# (required)
PORTFOLIO_URL=http://localhost:5173
# (required)
GITHUB_URL=https://github.com/your-handle
# (required)
LINKEDIN_URL=https://www.linkedin.com/in/your-handle

# --- Auth cookies ---
# Leave empty for host-only cookies; set to a parent domain (e.g. .example.com) to share.
COOKIE_DOMAIN=
# lax | strict | none. "none" forces Secure cookies.
COOKIE_SAMESITE=lax
# Must be true in production (HTTPS). false only for plain-HTTP local development.
COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# --- JWT ---
# (required) At least 32 characters when ENV=prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Visitor context ---
# true returns fixed sample data instead of calling geo/weather/FX providers.
CONTEXT_MOCK=true
# Optional. Your hourly rate in GBP, shown converted to the visitor's currency (Phase 3).
HOURLY_RATE_GBP=

# --- Pitch Me and anti-abuse (Phases 3-4; empty = feature off) ---
GEMINI_API_KEY=
TAVILY_API_KEY=
TURNSTILE_SECRET=
# Kill switch for the paid Pitch Me pipeline.
PITCH_ENABLED=false
# Maximum Pitch Me runs per day across all visitors.
PITCH_DAILY_CAP=100
# gemini | fake. "fake" is free and deterministic (local dev); refused in prod when enabled.
PITCH_LLM_PROVIDER=fake
PITCH_LLM_MODEL=gemini-2.5-flash
# tavily | fake. "fake" returns canned search results (local dev); refused in prod when enabled.
PITCH_RESEARCH_PROVIDER=fake
# Identical company + role requests replay from memory (per worker process) for this long.
PITCH_CACHE_TTL_HOURS=24
# Hard limit on one run, end to end.
PITCH_TIMEOUT_SECONDS=45
# With ENV=prod and PITCH_ENABLED=true the app refuses to start unless TURNSTILE_SECRET,
# GEMINI_API_KEY and TAVILY_API_KEY are set and neither provider is "fake".

# --- Image uploads for the content admin (Phase 4.5; empty bucket = uploads disabled) ---
# Same names as the server's existing .env. Use an IAM key that only needs s3:PutObject and
# s3:DeleteObject on arn:aws:s3:::<bucket>/<S3_UPLOAD_PREFIX>*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
# Base of every public image/résumé URL. Empty = https://<bucket>.s3.<region>.amazonaws.com
# (needs a public bucket). To keep the bucket private, serve files through the API instead:
#   prod:  https://api.aashish-regmi.com.np/api/v1/media
#   local: http://localhost:8001/api/v1/media
S3_PUBLIC_BASE_URL=
# Folder (key prefix) for every upload.
S3_UPLOAD_PREFIX=portfolio/
# Largest image the admin may upload, in megabytes.
S3_MAX_UPLOAD_MB=5

# --- Error tracking (optional; empty DSN = off) ---
# Sentry project DSN. No request bodies, cookies, auth headers or local variables are sent.
SENTRY_DSN=
# Environment name shown in Sentry. Empty = the value of ENV.
SENTRY_ENVIRONMENT=
# Share of requests traced for performance (0-1). 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Docker Compose and container start-up (not read by the app's settings) ---
# Host port the API container is published on. The EC2 VM behind Cloudflare uses 80 (443 once
# the container serves TLS, see docs/ORIGIN_TLS.md).
API_HOST_PORT=8001
# Image to run. Empty = a local build (portfolio-be-api:latest). On the VM scripts/deploy.sh sets
# it to the image CI published, ghcr.io/regmiaashish/portfolio-be:sha-<commit>.
API_IMAGE=
# Origin TLS (docs/ORIGIN_TLS.md). Leave all four empty/unset to serve plain HTTP.
# Compose files to combine; add docker-compose.tls.yaml to mount the certificate directory.
#COMPOSE_FILE=docker-compose.yaml:docker-compose.tls.yaml
# Host directory with origin.pem and origin.key (outside the repo), mounted read-only at /run/tls.
TLS_HOST_DIR=
# Certificate and private key paths inside the container. Both set = gunicorn serves HTTPS.
TLS_CERT_FILE=
TLS_KEY_FILE=
