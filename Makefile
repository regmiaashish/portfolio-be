.DEFAULT_GOAL := help

UV ?= uv
PYTHON := $(UV) run python
ALEMBIC := $(UV) run alembic
RUFF := $(UV) run ruff
COMPOSE := docker compose

.PHONY: help install sync dev run start docker-up docker-down docker-restart docker-logs \
	docker-build migrate migration revision seed-admin check format lint test clean

help:
	@echo "Portfolio backend commands"
	@echo "  make install          Install/sync locked dependencies"
	@echo "  make dev             Run the API locally with auto-reload"
	@echo "  make run             Run the API locally"
	@echo "  make start           Start the production Gunicorn server"
	@echo "  make docker-up       Build and start the API container"
	@echo "  make docker-down     Stop and remove the API container"
	@echo "  make docker-logs     Follow API container logs"
	@echo "  make migrate         Apply pending Alembic migrations"
	@echo "  make migration M=... Create an autogenerated migration"
	@echo "  make seed-admin      Create or reset the admin from ADMIN_* variables"
	@echo "  make check           Run lint checks"
	@echo "  make format          Format the source tree"
	@echo "  make test            Run tests (when a tests directory exists)"

install: sync

sync:
	@$(UV) sync --locked

dev:
	@$(UV) run uvicorn src.main:app --reload --host 0.0.0.0 --port $${PORT:-8001}

run:
	@$(UV) run uvicorn src.main:app --host 0.0.0.0 --port $${PORT:-8001}

start:
	@$(UV) run gunicorn src.main:app \
		--worker-class uvicorn.workers.UvicornWorker \
		--workers $${WEB_CONCURRENCY:-2} \
		--bind 0.0.0.0:$${PORT:-8001} \
		--timeout $${GUNICORN_TIMEOUT:-60}

docker-up:
	@$(COMPOSE) up -d --build

docker-down:
	@$(COMPOSE) down

docker-restart: docker-down docker-up

docker-build:
	@$(COMPOSE) build

docker-logs:
	@$(COMPOSE) logs -f api

migrate:
	@$(ALEMBIC) upgrade head

migration:
	@test -n "$(M)" || (echo 'Usage: make migration M="description"' && exit 1)
	@$(ALEMBIC) revision --autogenerate -m "$(M)"

revision: migration

seed-admin: migrate
	@$(UV) run python scripts/seed.py

lint:
	@$(RUFF) check src alembic

format:
	@$(RUFF) format src alembic

check: lint

test:
	@if [ -d tests ]; then $(UV) run pytest; else echo 'No tests directory found; nothing to run.'; fi

clean:
	@find . -type d -name __pycache__ -prune -exec rm -rf {} +
	@find . -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
